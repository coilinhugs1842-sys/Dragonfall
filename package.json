{
  "name": "dragonfall",
  "version": "0.0.0",
  "private": true,
  "description": "Browser dragon-riding team battler (1v1 to 5v5), three.js, host-authoritative peer-to-peer.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "peer:lan": "peerjs --port 9000 --path /dragonfall",
    "assets:inspect": "gltf-transform inspect"
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "lil-gui": "^0.21.0",
    "peer": "^1.0.2",
    "prettier": "^3.9.10",
    "stats-gl": "^4.2.3",
    "three-mesh-bvh": "^0.9.18",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
