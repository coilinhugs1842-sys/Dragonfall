# Normalize line endings for text
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary game assets go through Git LFS
*.glb filter=lfs diff=lfs merge=lfs -text
# Every .bin: glTF buffers and the map instance-transform files (MapPropSet.instances)
*.bin filter=lfs diff=lfs merge=lfs -text
